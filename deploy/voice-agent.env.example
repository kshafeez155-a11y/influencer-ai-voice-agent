# Copy this file to deploy/voice-agent.env and fill in real values.
# deploy.sh base64-encodes it into VM metadata; the startup script
# writes it as /opt/voice-agent/.env on the VM.
#
# PUBLIC_BASE_URL is the public HTTPS base URL of this server
# (no trailing slash). If it is left empty, deploy.sh also pushes a
# voice_domain metadata key and the startup script appends
# PUBLIC_BASE_URL=https://<voice_domain> automatically.
# Twilio media streams require wss:// in production, which Caddy
# provides via automatic Let's Encrypt HTTPS.

APP_NAME=voice-ai-server
APP_ENV=production
APP_PORT=8000
WEB_CALL_MAX_SECONDS=300
WEB_CALL_MAX_CONCURRENT=3
WEB_CALL_MAX_PER_IP_HOUR=10
WEB_CALL_SIGNING_SECRET=
LOG_LEVEL=INFO
CALL_MODE=web

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TEST_TO_PHONE_NUMBER=
PUBLIC_BASE_URL=https://tac.cytieq.com

ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2_realtime

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

CARTESIA_API_KEY=
CARTESIA_VOICE_ID=f786b574-daa5-4673-aa0c-cbe3e8534c02
CARTESIA_MODEL=sonic-3.5
CARTESIA_SAMPLE_RATE=24000

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=redis://localhost:6379/0
N8N_WEBHOOK_URL=

# SQLite file for influencer personas + call requests (relative to the
# service working directory on the VM: /opt/voice-agent).
DATABASE_PATH=voice_agent.db
# Optional bearer token guarding the admin API (Studio page).
# Leave empty to keep the admin API open for the prototype.
ADMIN_TOKEN=
