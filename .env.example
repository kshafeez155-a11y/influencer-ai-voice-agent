# ============================================================
# Voice AI Server configuration
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ---------- App ----------
APP_NAME=voice-ai-server
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
WEB_CALL_MAX_SECONDS=300
WEB_CALL_MAX_CONCURRENT=3
WEB_CALL_MAX_PER_IP_HOUR=10
WEB_CALL_SIGNING_SECRET=
LOG_LEVEL=INFO
CALL_MODE=web

# ---------- Twilio ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Verified number the prototype outbound call reaches
TEST_TO_PHONE_NUMBER=

# Public HTTPS base URL of this server, no trailing slash.
# Example: https://voice.example.com
# The /twilio/voice and /twilio/media-stream paths are appended automatically.
PUBLIC_BASE_URL=

# ---------- ElevenLabs (STT) ----------
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_STT_AUDIO_FORMAT=pcm
ELEVENLABS_STT_SAMPLE_RATE=16000

# ---------- Groq (LLM) ----------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---------- Cartesia (TTS) ----------
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=f786b574-daa5-4673-aa0c-cbe3e8534c02
CARTESIA_MODEL=sonic-3.5
CARTESIA_SAMPLE_RATE=24000

# ---------- Optional integrations (unused by the phone pipeline yet) ----------SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=redis://localhost:6379/0
N8N_WEBHOOK_URL=

# SQLite file for influencer personas + call requests
DATABASE_PATH=voice_agent.db
# Optional bearer token guarding the admin API
ADMIN_TOKEN=
